# Copy to .env and fill in.
# THE LOST EXPEDITION NPC Director (npc-director.ts). The director degrades gracefully:
# - No ANTHROPIC_API_KEY -> deterministic rule-based replies (NPCs never freeze).
# - No STDB_OWNER_TOKEN   -> cannot read the PRIVATE npc_utterance transcript, so it
#                            falls back to the deterministic line. Provide the owner
#                            token (from `spacetime login` / the publishing identity)
#                            to read transcripts, OR set npc_utterance PUBLIC in the
#                            module as the documented fallback.

# The Anthropic API key is read ONLY from here / process.env. NEVER hardcode it.
ANTHROPIC_API_KEY=

# Claude model id (verified). The director also still reads KEEPER_MODEL for back-compat.
DIRECTOR_MODEL=claude-opus-4-8

# SpacetimeDB connection.
STDB_HOST=ws://localhost:3000
STDB_DB=vibe-multiplayer

# Module owner token. TWO roles:
#  (1) FOREST lane (optional): lets the director read the PRIVATE npc_utterance
#      transcript via subscription. Without it the forest lane uses the deterministic
#      fallback (NPCs never freeze).
#  (2) BILLIONAIRE / "The Patron" lane (REQUIRED): the Patron's director-only reducers
#      call require_director(ctx) checking ctx.sender()==DIRECTOR_IDENTITY, so the lane
#      MUST run .withToken(STDB_OWNER_TOKEN) and that token's identity MUST be the baked
#      DIRECTOR_IDENTITY. WITHOUT this token the billionaire lane is DISABLED (the forest
#      lane still runs). It also enables the token-gated private reads
#      (billionaire_cognition cross-raid memory/composure, account_dossier, lobby_hook_truth).
# Get it from `spacetime login show --token` / your publishing identity.
STDB_OWNER_TOKEN=

# Voice pipeline (shared with media-server.ts; server-side only, never shipped to clients).
# The Patron's TTS uses ELEVENLABS_VOICE_ID (overrides the module-baked BILLIONAIRE_VOICE_ID
# at synth time); style param drifts smug->impatient->menacing with mood.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Safety-net pending-sweep interval (ms). onInsert is the hot path; this is the net.
DIRECTOR_TICK_MS=4000

# Heartbeat cadence (ms) while a Claude call is in flight. Must be well under the
# server's CLAIM_TIMEOUT_TICKS (60s) so a slow-but-alive call is never reclaimed.
DIRECTOR_HEARTBEAT_MS=12000
